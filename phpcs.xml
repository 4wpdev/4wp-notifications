<?xml version="1.0"?>
<ruleset name="4WP Notifications">
	<description>PHPCS for 4wp-notifications (extends 4wp-dev-toolkit).</description>

	<rule ref="../4wp-dev-toolkit/phpcs.xml.dist"/>

	<file>4wp-notifications.php</file>
	<file>admin</file>
	<file>includes</file>
	<file>install</file>
	<file>integrations</file>
	<file>rest</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/tests/*</exclude-pattern>
	<exclude-pattern>*/assets/*</exclude-pattern>

	<config name="text_domain" value="4wp-notifications"/>
</ruleset>
