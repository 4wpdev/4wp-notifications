{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "forwp/favorites-menu",
	"title": "4WP Favorites Menu",
	"category": "widgets",
	"description": "Heart icon with a dropdown of recent favorites. Use in header, rows, sidebars, or inside Navigation.",
	"textdomain": "4wp-notifications",
	"icon": "heart",
	"keywords": [ "4wp", "favorites", "heart", "menu", "navigation", "header", "saved" ],
	"attributes": {
		"limit": {
			"type": "number",
			"default": 5
		},
		"allUrl": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"reusable": false,
		"multiple": true,
		"interactivity": false,
		"inserter": true
	},
	"editorScript": "file:./editor.js",
	"style": "file:../../css/favorites-menu.css",
	"example": {
		"attributes": {
			"limit": 5
		}
	}
}
